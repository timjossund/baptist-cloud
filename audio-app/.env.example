# Base URL of the Baptist Cloud site the app calls (no trailing slash).
# iOS simulator: http://baptist-cloud.test
# Android emulator: the https URL from `herd share` (the emulator cannot reach .test names).
EXPO_PUBLIC_API_URL=http://baptist-cloud.test

# `development` builds "Baptist Cloud Dev" (its own app id, plain http allowed).
# Leave unset for production builds.
APP_VARIANT=development
